# Local OAuth test config — gitignored, never commit.
# Fill in the two values below from System OAuth > Application Registry.

SN_INSTANCE=https://{YOUR_INSTANCE}.service-now.com

SN__CLIENT_ID=
SN_CLIENT_SECRET=
SN_GRANT_TYPE=authorization_code

# Optional. Must match the Redirect URL on the OAuth app exactly.
# Defaults to http://localhost:33380/callback when omitted.
#SN_DEV343967_REDIRECT_URI=http://localhost:33380/callback

# Optional. Only enable if the OAuth app is configured to accept PKCE.
#SN_USE_PKCE=true

# OAuth-only run: no username/password, so execute_script, explore_syslog,
# explore_syslog_transaction, and explore_node_logs are intentionally not registered.
#SN_USERNAME=
#SN_PASSWORD=
